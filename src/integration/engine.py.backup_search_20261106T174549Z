LABOR = ("JOB", "INTERNSHIP")
FAMILIES = ("skills", "specializations", "job_titles", "governorates")
ENTITY_AR = {"JOB_TITLE": "المسمى الوظيفي", "ORGANIZATION": "الجهة", "SKILL": "المهارة", "DEGREE": "المؤهل",
             "MAJOR": "التخصص", "EXPERIENCE": "الخبرة", "LOCATION": "الموقع", "SALARY": "الراتب", "DEADLINE": "آخر موعد",
             "QUALIFICATION": "المؤهل", "SPECIALIZATION": "التخصص"}


# ───────────────────────────── أدوات نصية ─────────────────────────────
_DIAC = re.compile(r"[ً-ْـ]")


def norm(t) -> str:
    """تطبيع للمطابقة فقط (لا يُعرض): حروف صغيرة، توحيد الألف/الياء/التاء المربوطة، إزالة التشكيل."""
    t = _DIAC.sub("", str(t or "")).lower()
    t = re.sub("[إأآا]", "ا", t).replace("ى", "ي").replace("ة", "ه")
    t = re.sub(r"^ال(?=\w{3,})", "", t.strip())
    return re.sub(r"\s+", " ", re.sub(r"[^\w\s+#.]", " ", t)).strip()


def split_multi(s: str) -> list[str]:
    return [x.strip() for x in str(s or "").split(";") if x.strip()]


# ───────────────────────────── بيانات السوق ─────────────────────────────
class Market:
    """مؤشرات سوق العمل من الإعلانات الفريدة (بعد إزالة التكرار) في FINAL_TRAINING_DATASET."""

    def __init__(self, data_dir: Path = DATA_DIR):
        self.dir = Path(data_dir)

    @property
    def available(self) -> bool:
        return (self.dir / "unique_opportunities.csv").exists()

    def _need(self):
        if not self.available:
            raise FileNotFoundError(f"البيانات النهائية غير موجودة: {self.dir / 'unique_opportunities.csv'}")

    @cached_property
    def all_unique(self) -> pd.DataFrame:
        self._need()
        u = pd.read_csv(self.dir / "unique_opportunities.csv", dtype=str, keep_default_na=False)
        from src.integration.canon import canon_specs
        u["specializations_raw"] = u.specializations
        u["specializations"] = u.specializations.map(canon_specs)      # توحيد الصيغ للتحليل فقط
        u["date"] = pd.to_datetime(u.get("posting_date", ""), errors="coerce")
        u["month"] = u.date.dt.to_period("M").astype(str).where(u.date.notna(), "")
        return u

    @cached_property
    def jobs(self) -> pd.DataFrame:
        """الوظائف والتدريب العملي فقط (المنح/المناقصات/غير ذات الصلة خارج مؤشرات الطلب على المهارات)."""
        return self.all_unique[self.all_unique.opportunity_type.isin(LABOR)].copy()

    @cached_property
    def job_skills(self) -> pd.DataFrame:
        f = self.dir / "skills" / "job_skills.csv"
        if not f.exists():
            return pd.DataFrame(columns=["job_id", "skill_id", "name_ar", "name_en", "skill_type"])
        s = pd.read_csv(f, dtype=str, keep_default_na=False)
        s = s[s.decision == "accepted"] if "decision" in s else s
        return s[s.job_id.isin(set(self.jobs.job_id))].drop_duplicates(["job_id", "skill_id"])

    @cached_property
    def catalog(self) -> pd.DataFrame:
        f = self.dir / "skills" / "skill_catalog.csv"
        if f.exists():
            return pd.read_csv(f, dtype=str, keep_default_na=False)
        js = self.job_skills
        return js[["skill_id", "name_ar", "name_en", "skill_type"]].drop_duplicates("skill_id")

    def skill_name(self, sid: str) -> str:
        r = self.catalog[self.catalog.skill_id == sid]
        return (r.name_ar.iloc[0] or r.name_en.iloc[0]) if len(r) else sid

    # ── تصفية ──
    def filtered(self, governorate: str | None = None, specialization: str | None = None,
                 start: str | None = None, end: str | None = None, types=LABOR) -> pd.DataFrame:
        u = self.all_unique[self.all_unique.opportunity_type.isin(types)]
        if governorate:
            u = u[u.governorate == governorate]
        if specialization:
            u = u[u.specializations.map(lambda s: specialization in split_multi(s))]
        if start:
            u = u[(u.month != "") & (u.month >= start)]
        if end:
            u = u[(u.month != "") & (u.month <= end)]
        return u

    # ── مؤشرات ──
    def overview(self) -> dict:
        a, j = self.all_unique, self.jobs
        d = j.date.dropna()
        return {"unique_opportunities": int(len(a)), "unique_jobs_internships": int(len(j)),
                "organizations": int(j.get("organization_canonical", j.organization).replace("", np.nan).nunique()),
                "governorates_covered": int(j.governorate.replace("", np.nan).nunique()),
                "distinct_skills": int(self.job_skills.skill_id.nunique()),
                "jobs_with_skills_pct": round(100 * self.job_skills.job_id.nunique() / max(len(j), 1), 1),
                "date_from": str(d.min().date()) if len(d) else None, "date_to": str(d.max().date()) if len(d) else None,
                "sources": int(a.source_channel.replace("", np.nan).nunique()) if "source_channel" in a else None}

    def distribution(self, col: str, df: pd.DataFrame | None = None) -> pd.DataFrame:
        df = self.all_unique if df is None else df
        v = df[col].replace("", "غير محدد").value_counts()
        return pd.DataFrame({col: v.index, "count": v.values, "pct": (100 * v.values / max(v.sum(), 1)).round(1)})

    def top_skills(self, n: int = 20, df: pd.DataFrame | None = None, skill_type: str | None = None) -> pd.DataFrame:
        jobs = self.jobs if df is None else df
        js = self.job_skills[self.job_skills.job_id.isin(set(jobs.job_id))]
        if skill_type:
            js = js[js.skill_type == skill_type]
        c = js.groupby("skill_id").job_id.nunique().sort_values(ascending=False).head(n)
        out = pd.DataFrame({"skill_id": c.index, "jobs": c.values})
        out["skill"] = out.skill_id.map(self.skill_name)
        out["pct_of_jobs"] = (100 * out.jobs / max(len(jobs), 1)).round(1)
        return out[["skill", "skill_id", "jobs", "pct_of_jobs"]]

    def top_multi(self, col: str, n: int = 20, df: pd.DataFrame | None = None) -> pd.DataFrame:
        jobs = self.jobs if df is None else df
        x = jobs[["job_id", col]].assign(item=jobs[col].map(split_multi)).explode("item")
        x = x[x.item.notna() & (x.item != "")]
        c = x.groupby("item").job_id.nunique().sort_values(ascending=False).head(n)
        return pd.DataFrame({col: c.index, "jobs": c.values, "pct_of_jobs": (100 * c.values / max(len(jobs), 1)).round(1)})

    def top_titles(self, n: int = 20, df: pd.DataFrame | None = None) -> pd.DataFrame:
        from preprocessing.dedup import norm_title
        jobs = self.jobs if df is None else df
        t = jobs.job_title.map(norm_title)
        keep = jobs[t.str.len() >= 3].assign(key=t)
        g = keep.groupby("key").agg(jobs=("job_id", "nunique"), example=("job_title", lambda s: s.value_counts().index[0]))
        g = g.sort_values("jobs", ascending=False).head(n).reset_index(drop=True)
        g["pct_of_jobs"] = (100 * g.jobs / max(len(jobs), 1)).round(1)
        return g.rename(columns={"example": "job_title"})[["job_title", "jobs", "pct_of_jobs"]]

    def monthly(self, df: pd.DataFrame | None = None) -> pd.DataFrame:
        jobs = self.jobs if df is None else df
        m = jobs[jobs.month != ""].groupby(["month", "opportunity_type"]).size().unstack(fill_value=0)
        return m.sort_index()

    def skill_trend(self, skill_ids: list[str], df: pd.DataFrame | None = None) -> pd.DataFrame:
        """الحصة الشهرية من الإعلانات التي تذكر المهارة (من البيانات المرصودة، لا توقع)."""
        jobs = self.jobs if df is None else df
        jobs = jobs[jobs.month != ""]
        tot = jobs.groupby("month").size()
        js = self.job_skills[self.job_skills.skill_id.isin(skill_ids)].merge(jobs[["job_id", "month"]], on="job_id")
        c = js.groupby(["month", "skill_id"]).job_id.nunique().unstack(fill_value=0).reindex(tot.index, fill_value=0)
        return c.div(tot, axis=0).rename(columns=self.skill_name)

    def spec_skill(self, top_specs: int = 10, top_skills: int = 15, min_jobs: int = 5) -> dict:
        """علاقة التخصص ↔ المهارة: الحصة P(مهارة|تخصص) و Lift = P(مهارة|تخصص)/P(مهارة)."""
        j = self.jobs
        x = j[["job_id"]].assign(spec=j.specializations.map(split_multi)).explode("spec").dropna()
        x = x[x.spec != ""]
        specs = x.spec.value_counts()
        specs = specs[specs >= min_jobs].head(top_specs).index.tolist()
        skills = self.top_skills(top_skills).skill_id.tolist()
        if not specs or not skills:
            return {"share": pd.DataFrame(), "lift": pd.DataFrame(), "specs": specs, "skills": skills}
        has = self.job_skills[self.job_skills.skill_id.isin(skills)]
        base = has.groupby("skill_id").job_id.nunique() / max(len(j), 1)
        share = pd.DataFrame(index=specs, columns=skills, dtype=float)
        for s in specs:
            ids = set(x[x.spec == s].job_id)
            c = has[has.job_id.isin(ids)].groupby("skill_id").job_id.nunique()
            share.loc[s] = (c.reindex(skills, fill_value=0) / len(ids)).values
        lift = share.div(base.reindex(skills).replace(0, np.nan), axis=1)
        names = {k: self.skill_name(k) for k in skills}
        return {"share": share.rename(columns=names), "lift": lift.rename(columns=names), "specs": specs, "skills": skills}

    def search(self, query: str = "", governorate: str | None = None, opportunity_type: str | None = None,
               specialization: str | None = None, skill_id: str | None = None, limit: int = 200) -> pd.DataFrame:
        u = self.all_unique
        if opportunity_type:
            u = u[u.opportunity_type == opportunity_type]
        if governorate:
            u = u[u.governorate == governorate]
        if specialization:
            u = u[u.specializations.map(lambda s: specialization in split_multi(s))]
        if skill_id:
            u = u[u.job_id.isin(set(self.job_skills[self.job_skills.skill_id == skill_id].job_id))]
        q = norm(query)
        if q:
            hay = (u.job_title + " " + u.organization + " " + u.get("text_clean", u.raw_text).str[:3000]).map(norm)
            terms = q.split()
            u = u[hay.map(lambda h: all(t in h for t in terms))]
        cols = [c for c in ["posting_date", "job_title", "organization", "governorate", "opportunity_type",
                            "geographic_scope", "specializations", "education", "experience_min_years",
                            "application_deadline", "source_url"] if c in u.columns]
        return u.sort_values("posting_date", ascending=False)[cols].head(limit)

    def governorates(self) -> list[str]:
        return sorted(x for x in self.jobs.governorate.unique() if x)

    def specializations(self, min_jobs: int = 3) -> list[str]:
        v = self.jobs.specializations.map(split_multi).explode().dropna().value_counts()
        return [s for s, c in v.items() if s and c >= min_jobs]


