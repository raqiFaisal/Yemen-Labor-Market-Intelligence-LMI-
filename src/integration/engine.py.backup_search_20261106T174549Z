class SkillGap:
    """يقارن مهارات المستخدم بملف الطلب الفعلي لتخصص/مسمى في البيانات.

    ملف الطلب = المهارات التي تظهر في ≥ min_share من إعلانات الهدف، وزن كل مهارة = حصتها.
    نسبة التطابق = مجموع أوزان المهارات التي يملكها المستخدم ÷ مجموع الأوزان (تطابق مرجّح بالطلب).
    """

    def __init__(self, market: Market, forecasts: Forecasts | None = None):
        self.m, self.f = market, forecasts

    @cached_property
    def lexicon(self) -> dict[str, str]:
        lex = {}
        for r in self.m.catalog.itertuples():
            for name in (r.skill_id, r.name_ar, r.name_en):
                if name:
                    lex[norm(name)] = r.skill_id
        try:
            from preprocessing.taxonomy_seed import SKILLS   # (id, en, ar, type, domains, synonyms) — نفس قاموس الاستخراج
            known = set(self.m.catalog.skill_id)
            for row in SKILLS:
                if row[0] in known or not known:
                    for name in (row[1], row[2], *row[5]):
                        lex.setdefault(norm(name), row[0])
        except Exception:
            pass
        return lex

    def resolve(self, skills: list[str]) -> tuple[list[str], list[str]]:
        ids, unk = [], []
        for s in skills:
            k = norm(s)
            if not k:
                continue
            sid = self.lexicon.get(k)
            if sid is None:   # تطابق جزئي آمن: اسم مهارة كامل داخل المدخل أو العكس (≥ 4 أحرف)
                cand = [v for n, v in self.lexicon.items() if len(n) >= 4 and (n == k or (len(k) >= 4 and (k in n.split() or n in k.split())))]
                sid = cand[0] if len(set(cand)) == 1 else None
            (ids if sid else unk).append(sid or s)
        return list(dict.fromkeys(ids)), unk

    def target_jobs(self, specialization: str | None, title: str | None) -> tuple[pd.DataFrame, str]:
        j = self.m.jobs
        if specialization:
            return j[j.specializations.map(lambda s: specialization in split_multi(s))], f"تخصص: {specialization}"
        if title:
            q = norm(title).split()
            t = j.job_title.map(norm)
            return j[t.map(lambda h: all(w in h for w in q))], f"مسمى: {title}"
        return j, "كل السوق"

    def analyze(self, user_skills: list[str], target_specialization: str | None = None, target_title: str | None = None,
                min_share: float = 0.08, max_profile: int = 20, k_jobs: int = 10, min_target_jobs: int = 10) -> GapResult:
        if not user_skills or not any(str(s).strip() for s in user_skills):
            raise ValueError("أدخل مهارة واحدة على الأقل")
        have, unk = self.resolve(user_skills)
        tj, label = self.target_jobs(target_specialization, target_title)
        res = GapResult(target=label, n_target_jobs=int(len(tj)), unrecognized=unk)
        if len(tj) < min_target_jobs:
            res.note = f"عدد إعلانات الهدف ({len(tj)}) أقل من {min_target_jobs} — لا يكفي لبناء ملف طلب موثوق"
            return res
        js = self.m.job_skills[self.m.job_skills.job_id.isin(set(tj.job_id))]
        share = (js.groupby("skill_id").job_id.nunique() / len(tj)).sort_values(ascending=False)
        prof = share[share >= min_share].head(max_profile)
        if prof.empty:
            res.note = "لا توجد مهارات متكررة كافية في إعلانات هذا الهدف"
            return res
        hs = set(have)
        res.matched = [{"skill_id": s, "skill": self.m.skill_name(s), "demand_pct": round(100 * w, 1)} for s, w in prof.items() if s in hs]
        res.missing = [{"skill_id": s, "skill": self.m.skill_name(s), "demand_pct": round(100 * w, 1)} for s, w in prof.items() if s not in hs]
        res.match_pct = round(100 * prof[prof.index.isin(hs)].sum() / prof.sum(), 1)
        # أقرب الإعلانات: نسبة مهارات الإعلان التي يغطيها المستخدم (مع شرط تقاطع ≥ 1)
        per = js.groupby("job_id").skill_id.apply(set)
        rows = []
        for jid, ss in per.items():
            inter = len(ss & hs)
            if inter:
                rows.append({"job_id": jid, "coverage": inter / len(ss), "jaccard": inter / len(ss | hs),
                             "shared": "، ".join(self.m.skill_name(x) for x in ss & hs),
                             "missing": "، ".join(self.m.skill_name(x) for x in ss - hs)})
        if rows:
            nj = pd.DataFrame(rows).sort_values(["coverage", "jaccard"], ascending=False).head(k_jobs)
            meta = tj.set_index("job_id")[[c for c in ["job_title", "organization", "governorate", "posting_date", "source_url"] if c in tj]]
            nj = nj.join(meta, on="job_id")
            nj["coverage"] = (100 * nj.coverage).round(0)
            nj["jaccard"] = nj.jaccard.round(3)
            res.nearest_jobs = nj
        res.recommendations = self._recommend(res.missing)
        return res

    def _recommend(self, missing: list[dict], n: int = 5) -> list[dict]:
        trend = None
        if self.f:
            fam = self.f.family("skills")
            # اتجاه LSTM يُستخدم في التوصيات فقط إن تفوق النموذج على Naive في الاختبار
            if fam["status"] == "ok" and fam.get("trend") is not None and fam["metrics"].get("lstm_beats_naive_mae"):
                trend = fam["trend"].set_index("item")
        out = []
        for m in missing[:n]:
            r = {"skill": m["skill"], "demand_pct": m["demand_pct"],
                 "why": f"مطلوبة في {m['demand_pct']}% من إعلانات الهدف"}
            if trend is not None and m["skill_id"] in trend.index:
                t = trend.loc[m["skill_id"]]
                r["forecast_direction"] = t.direction
                r["why"] += f"؛ اتجاه توقع LSTM: {t.direction}"
            out.append(r)
        return out


# ───────────────────────────── الواجهة الموحدة ─────────────────────────────
class Engine:
    def __init__(self, data_dir: Path = DATA_DIR, models_dir: Path = MODELS_DIR, reports_dir: Path = REPORTS_DIR):
        self.market = Market(data_dir)
        self.forecasts = Forecasts(reports_dir)
        self.ads = AdAnalyzer(models_dir)
        self.gap = SkillGap(self.market, self.forecasts)
        self.reports_dir = Path(reports_dir)

    def analyze_ad(self, text: str) -> dict:
        return self.ads.analyze(text)

    def skill_gap(self, skills: list[str], **kw) -> GapResult:
        return self.gap.analyze(skills, **kw)

    def evaluation_results(self) -> dict:
        """نتائج التقييم المحفوظة (test) للنماذج وخطوط الأساس — للعرض في صفحة معلومات النماذج."""
        ev = self.reports_dir / "evaluation"
        out = {}
        for name in ("classification_opportunity_type", "classification_geographic_scope", "ner",
                     "baseline_opportunity_type", "baseline_geographic_scope", "baseline_ner"):
            f = ev / name / "metrics.json"
            out[name] = json.loads(f.read_text(encoding="utf-8")) if f.exists() else None
        out["lstm"] = self.forecasts.summary()
        return out
