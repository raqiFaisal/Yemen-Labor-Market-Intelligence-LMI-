class Forecasts:
    """قراءة مخرجات LSTM المحفوظة فقط (لا تدريب داخل التطبيق)."""

    def __init__(self, reports_dir: Path = REPORTS_DIR):
        self.dir = Path(reports_dir) / "evaluation"

    def summary(self) -> dict | None:
        f = self.dir / "lstm_summary.json"
        return json.loads(f.read_text(encoding="utf-8")) if f.exists() else None

    def family(self, fam: str) -> dict:
        d = self.dir / f"lstm_{fam}"
        if not (d / "metrics.json").exists():
            return {"family": fam, "status": "not_available", "reason": "لم يُشغَّل تدريب LSTM لهذه العائلة بعد"}
        m = json.loads((d / "metrics.json").read_text(encoding="utf-8"))
        if not m.get("trained"):
            return {"family": fam, "status": "not_trained", "reason": m.get("reason"), "metrics": m,
                    "sufficiency": self._csv(d / "sufficiency.csv")}
        return {"family": fam, "status": "ok", "metrics": m,
                "history": self._csv(d / "series_used.csv", index_col=0),
                "future": self._csv(d / "future_forecast.csv", index_col=0),
                "trend": self._csv(d / "trend_forecast.csv"),
                "test_predictions": self._csv(d / "test_predictions.csv"),
                "per_series": self._csv(d / "per_series_test_mae.csv"),
                "sufficiency": self._csv(d / "sufficiency.csv"),
                "plot": str(d / "actual_vs_predicted.png") if (d / "actual_vs_predicted.png").exists() else None}

    @staticmethod
    def _csv(f: Path, **kw):
        return pd.read_csv(f, encoding="utf-8-sig", **kw) if f.exists() else None


# ───────────────────────────── تحليل الإعلان (نماذج DL فقط) ─────────────────────────────
class AdAnalyzer:
    """يحمّل نماذج AraBERT المحفوظة مرة واحدة. كل مكوّن مستقل: غياب نموذج لا يوقف البقية ولا يُستبدل بقواعد."""

    def __init__(self, models_dir: Path = MODELS_DIR):
        self.dir = Path(models_dir)
        self._cache: dict = {}

    def paths(self) -> dict:
        return {"opportunity_type": self.dir / "classification" / "opportunity_type",
                "geographic_scope": self.dir / "classification" / "geographic_scope",
                "ner": self.dir / "ner"}

    def offline_paths(self) -> dict:
        return {"opportunity_type": self.dir / "offline" / "classification" / "opportunity_type",
                "geographic_scope": self.dir / "offline" / "classification" / "geographic_scope",
                "ner": self.dir / "offline" / "ner"}

    def status(self) -> dict:
        """Return checkpoint validation, including source architecture and provenance.

        If AraBERT is absent but a genuine CPU-trained checkpoint exists,
        use it explicitly under its own model_family, never disguise it.
        """
        from src.inference.predictors import _check_dir, ModelNotAvailable
        out = {}
        for k, pretrained_path in self.paths().items():
            geo_path = self.dir / "offline" / "classification" / "geographic_scope_v2"
            if k == "geographic_scope" and (geo_path / "model.pt").is_file() and (geo_path / "config.json").is_file():
                info = {"available": True, "path": str(geo_path),
                        "model_family": "GeoScopeNetV2 (PyTorch; supervised SILVER)",
                        "pretrained_available": False,
                        "config": json.loads((geo_path / "config.json").read_text(encoding="utf-8"))}
                out[k] = info
                continue
            offline_path = self.offline_paths()[k]
            try:
                _check_dir(pretrained_path)
                ok, p, model_family = True, pretrained_path, "AraBERT fine-tuned"
            except ModelNotAvailable:
                geo_path = self.dir / "offline" / "classification" / "geographic_scope_v2"
                if k == "geographic_scope" and (geo_path / "model.pt").is_file() and (geo_path / "config.json").is_file():
                    ok, p, model_family = True, geo_path, "GeoScopeNetV2 (PyTorch; supervised SILVER)"
                else:
                    ok = (offline_path / "config.json").is_file() and (offline_path / "model.pt").is_file()
                    p = offline_path if ok else pretrained_path
                    model_family = "PyTorch CPU neural baseline trained from scratch (SILVER)" if ok else "unavailable"
            info = {"available": ok, "path": str(p), "model_family": model_family,
                    "pretrained_available": model_family == "AraBERT fine-tuned"}
            for fn in ("training_config.json", "best_validation_metrics.json", "config.json"):
                if (p / fn).exists():
                    info[fn.split(".")[0]] = json.loads((p / fn).read_text(encoding="utf-8"))
            out[k] = info
        return out

    def _load(self, key: str):
        from src.inference.predictors import NERTagger, TextClassifier, _check_dir, ModelNotAvailable
        if key not in self._cache:
            if key == "geographic_scope":
                geo_path = self.dir / "offline" / "classification" / "geographic_scope_v2"
                if (geo_path / "model.pt").is_file() and (geo_path / "config.json").is_file():
                    from src.offline.geographic_v2 import GeoScopeClassifier
                    self._cache[key] = GeoScopeClassifier(geo_path)
                    return self._cache[key]
            pretrained_path = self.paths()[key]
            try:
                _check_dir(pretrained_path)
                self._cache[key] = NERTagger(pretrained_path) if key == "ner" else TextClassifier(pretrained_path)
            except ModelNotAvailable as pretrained_error:
                if key == "geographic_scope":
                    geo_path = self.dir / "offline" / "classification" / "geographic_scope_v2"
                    if (geo_path / "model.pt").is_file() and (geo_path / "config.json").is_file():
                        from src.offline.geographic_v2 import GeoScopeClassifier
                        self._cache[key] = GeoScopeClassifier(geo_path)
                        return self._cache[key]
                from src.offline.neural import OfflineClassifier, OfflineNERTagger
                offline_path = self.offline_paths()[key]
                if not (offline_path / 'model.pt').exists():
                    raise pretrained_error
                self._cache[key] = OfflineNERTagger(offline_path) if key == "ner" else OfflineClassifier(offline_path)
        return self._cache[key]

    def analyze(self, text: str) -> dict:
        from src.inference.predictors import ModelNotAvailable
        text = (text or "").strip()
        if len(text) < 15:
            raise ValueError("النص قصير جداً للتحليل (أقل من 15 حرفاً)")
        if len(text) > 20000:
            text = text[:20000]
        res = {"text_chars": len(text), "components": {}}
        for key in ("opportunity_type", "geographic_scope"):
            try:
                res["components"][key] = {"status": "ok", **self._load(key).predict(text)}
            except ModelNotAvailable as e:
                res["components"][key] = {"status": "model_not_available", "reason": str(e)}
        try:
            ner = self._load("ner").extract(text)
            ents = ner["entities"]
            grouped: dict[str, list] = {}
            for e in ents:
                lst = grouped.setdefault(e["label"], [])
                if e["text"] not in [x["text"] for x in lst]:
                    lst.append({"text": e["text"], "confidence": e["confidence"]})
            res["components"]["ner"] = {"status": "ok", "entities": ents, "grouped": grouped,
                                        "n_entities": len(ents), "model_family": ner.get("model_family", "AraBERT fine-tuned")}
        except ModelNotAvailable as e:
            res["components"]["ner"] = {"status": "model_not_available", "reason": str(e)}
        res["all_models_available"] = all(c["status"] == "ok" for c in res["components"].values())
        return res


